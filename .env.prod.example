# Copy to .env.prod and fill in values before running docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# Postgres
POSTGRES_USER=mediku
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=mediku

# App
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://mediku.appunnes.id
NODE_ENV=production

# Firebase (optional — password reset disabled if not set)
# Generate: base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=

# SSL cert paths on the host machine (e.g. from certbot)
# Example: /etc/letsencrypt/live/mediku.appunnes.id/fullchain.pem
SSL_CERT_PATH=/etc/letsencrypt/live/mediku.appunnes.id/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mediku.appunnes.id/privkey.pem
