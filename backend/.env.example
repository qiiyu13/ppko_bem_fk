PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5433/mediku"
JWT_SECRET="change-this-to-random-string"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="mediku-api"           # Token issuer claim (iss)
JWT_AUDIENCE="mediku-app"         # Token audience claim (aud)
MAX_SESSION_AGE_SECONDS=2592000  # Absolute session cap since first login (default 30d)
CORS_ORIGIN="https://mediku.appunnes.id"
NODE_ENV=development
FIREBASE_SERVICE_ACCOUNT=  # Base64-encoded Firebase service account JSON (required for password reset)
