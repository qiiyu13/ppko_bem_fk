PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5433/mediku"
JWT_SECRET="change-this-to-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="https://your-app-domain.com"  # Set to your Flutter app's domain in production
NODE_ENV=development
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
DAILY_CHAT_LIMIT=50  # Max AI chat messages per user per day (cost protection)
FIREBASE_SERVICE_ACCOUNT=  # Base64-encoded Firebase service account JSON

