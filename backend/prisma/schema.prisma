generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
  SUPERADMIN
}

model User {
  id              String   @id @default(uuid())
  kkNumber        String?  @unique @map("kk_number") @db.VarChar(16)
  username        String?  @unique @map("username") @db.VarChar(50)
  password        String
  phone           String?
  responsibleName String   @map("responsible_name")
  position        String?  @db.VarChar(100)
  role            Role     @default(PATIENT)
  isActive        Boolean  @default(true) @map("is_active")
  avatarPath      String?  @map("avatar_path")
  fcmToken        String?  @map("fcm_token")
  regionId        String?  @map("region_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  region          Region?            @relation(fields: [regionId], references: [id])
  familyProfiles  FamilyProfile[]
  profileLinks    ProfileLink[]
  screenings      MedicalScreening[] @relation("Screener")
  createdArticles Article[]          @relation("Author")
  appointments    Appointment[]
  notifications   Notification[]

  @@index([regionId])
  @@map("users")
}

model FamilyProfile {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  name         String
  nik          String?   @unique
  gender       String
  birthDate    DateTime? @map("birth_date")
  height       Float?
  weight       Float?
  avatarPath   String?   @map("avatar_path")
  bloodType    String?   @map("blood_type")
  phone        String?
  address      String?
  mergedIntoId String?   @map("merged_into_id")

  // Demografi (values are lowercase keys, validated at the API layer)
  education            String?
  occupation           String?
  maritalStatus        String?   @map("marital_status")
  income               Float?
  familyDiseaseHistory String?   @map("family_disease_history")

  // Gaya hidup — current values; screenings snapshot their own copy
  smokingStatus         String?  @map("smoking_status")
  physicalActivity      String?  @map("physical_activity")
  fruitConsumption      String?  @map("fruit_consumption")
  vegetableConsumption  String?  @map("vegetable_consumption")
  sweetFoodConsumption  String?  @map("sweet_food_consumption")
  sweetDrinkConsumption String?  @map("sweet_drink_consumption")
  fattyFoodConsumption  String?  @map("fatty_food_consumption")
  fastFoodConsumption   String?  @map("fast_food_consumption")
  sleepDuration         Float?   @map("sleep_duration")
  medicationRoutine     String?  @map("medication_routine")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  metrics      HealthMetric[]
  screenings   MedicalScreening[] @relation("PatientProfile")
  appointments Appointment[]
  links        ProfileLink[]
  mergedInto   FamilyProfile?     @relation("ProfileMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   FamilyProfile[]    @relation("ProfileMerge")

  @@index([userId])
  @@index([mergedIntoId])
  @@map("family_profiles")
}

model ProfileLink {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  userId    String   @map("user_id")
  role      String   @default("family")
  createdAt DateTime @default(now()) @map("created_at")

  profile FamilyProfile @relation(fields: [profileId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@unique([profileId, userId])
  @@index([userId])
  @@map("profile_links")
}

model HealthMetric {
  id             String   @id @default(uuid())
  profileId      String   @map("profile_id")
  type           String
  value          Float
  secondaryValue Float?   @map("secondary_value")
  unit           String
  notes          String?
  recordedAt     DateTime @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profile FamilyProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([type])
  @@index([recordedAt])
  @@index([profileId, type, recordedAt(sort: Desc)])
  @@map("health_metrics")
}

model MedicalScreening {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  screenedBy  String   @map("screened_by")
  systolic    Int
  diastolic   Int
  bloodSugar  Float?   @map("blood_sugar")
  cholesterol Float?
  uricAcid    Float?   @map("uric_acid")
  height      Float?
  weight      Float?

  // Antropometri tambahan + nadi (waist-hip ratio is computed, never stored)
  waistCircumference     Float?  @map("waist_circumference")
  abdominalCircumference Float?  @map("abdominal_circumference")
  hipCircumference       Float?  @map("hip_circumference")
  pulse                  Int?

  // Snapshot perilaku saat screening (defaults live on FamilyProfile)
  smokingStatus         String?  @map("smoking_status")
  physicalActivity      String?  @map("physical_activity")
  fruitConsumption      String?  @map("fruit_consumption")
  vegetableConsumption  String?  @map("vegetable_consumption")
  sweetFoodConsumption  String?  @map("sweet_food_consumption")
  sweetDrinkConsumption String?  @map("sweet_drink_consumption")
  fattyFoodConsumption  String?  @map("fatty_food_consumption")
  fastFoodConsumption   String?  @map("fast_food_consumption")
  sleepDuration         Float?   @map("sleep_duration")
  medicationRoutine     String?  @map("medication_routine")

  irdScore    Float    @map("ird_score")
  irdCategory String   @map("ird_category")
  notes       String?
  screeningAt DateTime @map("screening_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile  FamilyProfile @relation("PatientProfile", fields: [profileId], references: [id])
  screener User          @relation("Screener", fields: [screenedBy], references: [id])

  @@index([profileId])
  @@index([screenedBy])
  @@index([irdCategory])
  @@index([screeningAt])
  @@index([profileId, screeningAt(sort: Desc)])
  @@index([screenedBy, screeningAt(sort: Desc)])
  @@map("medical_screenings")
}

model Appointment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profileId String?  @map("profile_id")
  title     String
  date      DateTime
  location  String?
  notes     String?
  type      String   @default("GENERAL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id])
  profile FamilyProfile? @relation(fields: [profileId], references: [id])

  @@index([userId])
  @@index([profileId])
  @@index([date])
  @@index([type])
  @@map("appointments")
}

model Article {
  id          String    @id @default(uuid())
  authorId    String    @map("author_id")
  title       String
  content     String
  imagePath   String?   @map("image_path")
  tags        String[]
  isPublished Boolean   @default(false) @map("is_published")
  isDraft     Boolean   @default(true) @map("is_draft")
  publishDate DateTime? @map("publish_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User @relation("Author", fields: [authorId], references: [id])

  @@index([authorId])
  @@index([isPublished])
  @@index([publishDate])
  @@index([isPublished, isDraft, publishDate(sort: Desc)])
  @@map("articles")
}

model Region {
  id        String   @id @default(uuid())
  type      String
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[] @relation("RegionHierarchy")
  users    User[]

  @@unique([type, name, parentId])
  @@index([parentId])
  @@index([name])
  @@map("regions")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("token_blacklist")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}
